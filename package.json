{
  "name": "dotnet-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run package:examples",
    "dev": "vite",
    "prebuild": "npm run package:examples",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:dotnet": "dotnet test examples/TaskFlow.Api.Tests -c Release",
    "test:cli": "node scripts/check-cli.mjs",
    "test:snippets": "node scripts/check-snippets.mjs",
    "package:examples": "node scripts/package-examples.mjs",
    "format": "prettier --write src scripts e2e *.ts *.json index.html README.md docs/*.md examples/README.md",
    "format:check": "prettier --check src scripts e2e *.ts *.json index.html README.md docs/*.md examples/README.md"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide-react": "^1.49.0",
    "mermaid": "^11.17.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
